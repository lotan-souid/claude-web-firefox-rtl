{
  "manifest_version": 3,
  "name": "Claude Web RTL",
  "version": "0.1.1",
  "description": "Adds automatic right-to-left support for Hebrew conversations in Claude.",
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-web-firefox-rtl@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "css": [
        "src/content.css"
      ],
      "js": [
        "src/direction.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
